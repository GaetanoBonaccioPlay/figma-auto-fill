{
  "manifest_version": "0.3",
  "name": "figma-auto-fill",
  "display_name": "Figma Auto Fill",
  "version": "0.0.0",
  "description": "Localizza i frame Figma a partire da un Excel cliente, guidato da Claude e dal plugin Figma Auto Fill.",
  "author": { "name": "Playground" },
  "server": {
    "type": "node",
    "entry_point": "server/index.cjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.cjs"]
    }
  },
  "compatibility": {
    "platforms": ["darwin"],
    "runtimes": { "node": ">=18.0.0" }
  }
}
